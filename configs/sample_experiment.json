{
  "name": "storyboard_framework_baseline",
  "description": "Baseline config for the modular manga generation framework.",
  "seed": 123,
  "output_dir": "outputs",
  "model": {
    "backend": "mock",
    "model_id": "mock-storyboard-backend",
    "device": "cpu",
    "dtype": "float32",
    "params": {
      "image_size": [768, 768]
    }
  },
  "adapters": [
    {
      "type": "style_prompt",
      "enabled": true,
      "weight": 0.8,
      "params": {
        "style_prompt": "black and white manga screentone, expressive line art"
      }
    },
    {
      "type": "controlnet",
      "enabled": true,
      "weight": 1.0,
      "params": {
        "prompt_hint": "dynamic panel composition, strong foreground-background separation",
        "controls": {
          "panel_layout": "single dramatic panel"
        }
      }
    },
    {
      "type": "ip_adapter",
      "enabled": false,
      "weight": 1.0,
      "params": {
        "identity_prompt": "same protagonist identity as reference image",
        "reference_images": []
      }
    }
  ],
  "refinement": {
    "type": "flux",
    "enabled": true,
    "params": {
      "save_copy": true
    }
  },
  "evaluation": {
    "metrics": [
      "file_integrity",
      "image_statistics",
      "histogram_consistency",
      "latency"
    ],
    "params": {}
  },
  "prompts": [
    {
      "id": "scene_1",
      "prompt": "A rooftop confrontation at sunset between two teenagers in manga style, dramatic shadows, wind movement, tense body language",
      "negative_prompt": "blurry, malformed hands, low contrast, extra limbs",
      "output_name": "scene_1_panel",
      "seed": 101,
      "guidance_scale": 8.5,
      "num_inference_steps": 28,
      "controls": {
        "shot_type": "wide shot",
        "camera_angle": "low angle"
      },
      "metadata": {
        "task": "storyboard_panel_generation"
      }
    },
    {
      "id": "character_hero",
      "prompt": "Close-up manga portrait of Hiro, messy hair, cheek cut, determined expression, high-contrast ink shading",
      "negative_prompt": "blurry, distorted face, duplicate eyes",
      "output_name": "hiro_closeup",
      "seed": 102,
      "guidance_scale": 7.0,
      "num_inference_steps": 24,
      "controls": {
        "shot_type": "close up"
      },
      "metadata": {
        "character": "Hiro"
      }
    }
  ]
}
